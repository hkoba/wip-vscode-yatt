{
	"name": "yatt-langserver",
	"displayName": "yatt-langserver",
	"description": "Language Server for yatt",
	"publisher": "hkoba",
        "repository": {
          "url": "git+https://github.com/hkoba/wip-vscode-yatt.git"
        },
	"version": "0.2.6",
	"license": "Artistic-2.0",
	"engines": {
		"vscode": "^1.96.0"
	},
	"categories": [
		"Other"
	],
	"main": "./out/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "yatt",
				"aliases": [
					"yatt",
					"yatt"
				],
				"extensions": [
					".yatt",
					".ytmpl"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"themes": [
			{
				"label": "yatt default",
				"uiTheme": "vs",
				"path": "themes/yatt_default.json"
			}
		],
		"grammars": [
			{
				"language": "yatt",
				"scopeName": "text.html.yatt",
				"path": "./syntaxes/yatt.tmLanguage.json"
			},
			{
				"language": "yatt",
				"scopeName": "text.multipart.yatt",
				"path": "./syntaxes/yatt-multipart.tmLanguage.json"
			}
		],
		"configuration": {
			"type": "object",
			"title": "yatt langserver configuration",
			"properties": {
				"yattLanguageServer.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "verbose",
					"description": "Traces the communication between VS Code and the language server."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && node ./out/test/runTest.js",
		"lint": "eslint src --ext ts"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.17.10",
		"@types/vscode": "^1.96.0",
		"@typescript-eslint/eslint-plugin": "^8.19.0",
		"@typescript-eslint/parser": "^8.19.0",
		"eslint": "^8.57.1",
		"typescript": "^5.7.2",
		"@vscode/test-electron": "^2.4.1"
	}
}
